{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chemclaw-fleet values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "readyDelay": { "type": "integer", "minimum": 0 },
        "liveDelay": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 2 },
        "scaleDownWindow": { "type": "integer", "minimum": 0 },
        "scratch": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "secretName": { "type": "string", "minLength": 1 },
    "drainSeconds": { "type": "integer", "minimum": 0 },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callerLabels": { "type": "object", "minProperties": 1 },
        "scraperNamespaces": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "serviceMonitor": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["hpa", "keda"] },
        "cpuUtilization": { "type": "integer", "minimum": 50, "maximum": 85 }
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "requestTimeout", "resources"],
        "properties": {
          "port": { "type": "integer", "minimum": 8850, "maximum": 8899 },
          "requestTimeout": { "type": "integer", "minimum": 1 },
          "resources": {
            "type": "object",
            "required": ["requests", "limits"],
            "properties": {
              "requests": { "type": "object", "required": ["cpu", "memory"] },
              "limits": { "type": "object", "required": ["cpu", "memory"] }
            }
          },
          "replicas": { "type": "integer", "minimum": 1 },
          "readyDelay": { "type": "integer", "minimum": 0 },
          "liveDelay": { "type": "integer", "minimum": 0 },
          "maxReplicas": { "type": "integer", "minimum": 2 },
          "scaleDownWindow": { "type": "integer", "minimum": 0 },
          "scratch": { "type": "string", "minLength": 1 },
          "writableRoot": { "type": "boolean" },
          "keda": { "type": "boolean" },
          "image": { "$ref": "#/definitions/image" }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "namePrefix": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
