{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chemclaw-fleet values",
  "description": "Every object is closed and every string that reaches a manifest has a pattern; templates also quote what they interpolate. A moving image tag is refused by the template (chemclaw-fleet.image), not here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "description": "Reserved for parent charts; no template reads it.", "type": "object" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "readyDelay": { "type": "integer", "minimum": 0 },
        "liveDelay": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 2 },
        "scaleDownWindow": { "type": "integer", "minimum": 0 },
        "scratch": { "$ref": "#/definitions/size" },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "secretName": { "$ref": "#/definitions/dnsName" },
    "drainSeconds": { "type": "integer", "minimum": 0 },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callerLabels": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9]([A-Za-z0-9._/-]*[A-Za-z0-9])?$" },
          "additionalProperties": { "type": "string", "pattern": "^([A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?)?$" }
        },
        "scraperNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/dnsLabel" }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "$ref": "#/definitions/duration" },
        "scrapeTimeout": { "$ref": "#/definitions/duration" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["hpa", "keda", "none"] },
        "cpuUtilization": { "type": "integer", "minimum": 50, "maximum": 85 },
        "scaleUpWindow": { "type": "integer", "minimum": 0 },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$", "type": "string" },
            "serverAddress": { "type": "string", "pattern": "^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?$" },
            "threshold": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
            "pollingInterval": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "requestTimeout", "resources"],
        "properties": {
          "port": { "type": "integer", "minimum": 8850, "maximum": 8899 },
          "requestTimeout": { "type": "integer", "minimum": 1 },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requests", "limits"],
            "properties": {
              "requests": { "$ref": "#/definitions/quantities" },
              "limits": { "$ref": "#/definitions/quantities" }
            }
          },
          "replicas": { "type": "integer", "minimum": 1 },
          "readyDelay": { "type": "integer", "minimum": 0 },
          "liveDelay": { "type": "integer", "minimum": 0 },
          "maxReplicas": { "type": "integer", "minimum": 2 },
          "scaleDownWindow": { "type": "integer", "minimum": 0 },
          "scratch": { "$ref": "#/definitions/size" },
          "writableRoot": { "type": "boolean" },
          "keda": { "type": "boolean" },
          "image": { "$ref": "#/definitions/image" }
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "dnsName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
    "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
    "size": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$" },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": ["string", "number"], "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$" },
        "memory": { "type": ["string", "number"], "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$" },
        "namePrefix": { "type": "string", "pattern": "^[a-z0-9._-]*$" },
        "tag": { "type": "string", "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
