# The `rxnlabel` server as one rootless image.
#
# Not boring, and the interesting part is the model. This server's optional `models` extra carries
# RXNMapper, a transformer, and the fleet's hard rule is that no server makes an outbound call at
# request time. RXNMapper 0.4.3 keeps that rule by construction: its ALBERT checkpoint ships
# *inside its wheel* (`rxnmapper/models/transformers/albert_heads_8_uspto_all_1310k/`, 3.2 MB) and
# `RXNMapper()` loads it from that package path, so the weights arrive with the same
# `--require-hashes` install as the code, under a hash `uv.lock` records. There is nothing to
# download and no HuggingFace cache. The NetworkPolicy beside this file denies egress anyway, so a
# future release that did reach for the hub reports the mapper absent rather than dialling out.
FROM python:3.11-slim AS build

WORKDIR /build
# **The lock, because an image that re-resolves is an image nobody audited.**
# `make deps-audit` reads `uv.lock`; until this line existed no Containerfile in this repository
# copied it, so all seven re-resolved independently from the open lower bounds in each
# `pyproject.toml`. Measured 2026-08-28 against the `rxnpredict` image: 11 of 100 packages differed
# from the export the audit reads, `pandas` by a major version — so the supply-chain gate proved a
# property of a file and not of anything shipped
# (`D-2026-09-13-an-audit-of-a-lockfile-no-image-reads-audits-nothing`).
COPY pyproject.toml uv.lock /build/
COPY packages/mcp_server_kit /build/packages/mcp_server_kit
COPY servers/rxnlabel /build/servers/rxnlabel

# Wheels, not an editable install: what ships is what a `pip install` of the two packages produces,
# which is also what the tests import.
# Two `pip wheel` passes with the build backend installed in front of them, and the split is the
# point. The first pass resolves *nothing*: every third-party version and hash comes from `uv.lock`
# by way of `uv export --frozen`, so what this image installs is what `make deps-audit` read. The
# second builds the two workspace packages `--no-deps`, because their dependencies are already in
# the wheelhouse and letting pip look again is exactly the re-resolution this replaced.
#
# **`--no-build-isolation` on the second pass is what makes the backend the lock's rather than the
# day's.** Both workspace distributions declare `build-system.requires = ["hatchling"]` with no
# bound, so without it pip fetches a backend from PyPI at this moment — unhashed, absent from
# `uv.lock`, and then *executed*. Measured across hatchling 1.21.1 and 1.32.3 on this workspace:
# identical member sets and byte-identical payloads, with `WHEEL`, `METADATA` and `RECORD` differing
# — `Metadata-Version: 2.1` against `2.5`. So the backend decides the metadata a wheel advertises
# itself with, which is a smaller harm than a dropped corpus and is still a build whose output is a
# function of the date (`D-2026-09-18-a-backend-that-writes-the-metadata-is-a-dependency-of-the-wheel`).
#
# **The one extra index is the one `uv.lock` names as torch's source, and it is on the hashed pass
# only** (`D-2026-09-27-a-cpu-pod-locks-the-cpu-torch`). The lock resolves `torch==2.13.0+cpu` from
# PyTorch's CPU index for Linux, and `uv export` has no flag that writes an index into the
# requirements file, so pip has to be told where that one wheel lives. It cannot choose anything
# with it: `--require-hashes` rejects any artefact whose digest the lock did not record, whichever
# index offered it. `tests/test_fleet.py::test_no_image_installs_what_the_lock_did_not_hash`
# accepts an index flag only in this shape and only naming a registry `uv.lock` records.
#
# `uv` is pinned only by a range: `--frozen` means the *resolution* cannot drift whichever
# version runs, and a `uv` that changed this CLI would fail the build loudly rather than
# quietly ship a different closure.
RUN python -m pip install --no-cache-dir --upgrade pip "uv>=0.8.17,<1" \
    && uv export --frozen --package chemclaw-mcp-rxnlabel --extra models --no-dev \
         --no-emit-workspace --format requirements-txt -o /build/requirements.txt \
    && uv export --frozen --only-group build --no-emit-workspace \
         --format requirements-txt -o /build/build-requirements.txt \
    && python -m pip install --no-cache-dir --require-hashes -r /build/build-requirements.txt \
    && python -m pip wheel --no-cache-dir --wheel-dir /wheels \
         --require-hashes -r /build/requirements.txt \
         --extra-index-url https://download.pytorch.org/whl/cpu \
    && python -m pip wheel --no-cache-dir --no-deps --no-build-isolation --wheel-dir /wheels \
        ./packages/mcp_server_kit "./servers/rxnlabel[models]"

FROM python:3.11-slim

# **A numeric UID, in group 0, with `HOME` on the scratch mount** — the OpenShift arbitrary-UID
# convention. The number is what lets a kubelet verify `runAsNonRoot` against the image; no
# Deployment pins it, because `restricted-v2` assigns a UID from the namespace's range (always
# with GID 0) and rejects any other. Such a UID has no `/etc/passwd` entry, so a runtime would set
# `HOME=/`; `/tmp` is the one path every Deployment mounts writable, whatever the UID.
ARG UID=1001
RUN useradd --uid ${UID} --gid 0 --create-home --shell /usr/sbin/nologin app
ENV HOME=/tmp

# **Three system libraries, because Rxn-INSIGHT imports RDKit's drawing module.**
# `rxn_insight.utils` does `from rdkit.Chem.Draw import rdMolDraw2D` at import time, and the locked
# RDKit wheel (2026.3.5) links that extension against `libXrender.so.1`, `libXext.so.6`,
# `libX11.so.6` and `libexpat.so.1`, none of which `python:3.11-slim` carries (`libX11` arrives as a
# dependency). Without them the import check at the end of this stage fails with `ImportError:
# libXrender.so.1` — found by the first build that reached that check, on 2026-09-26; every earlier
# build of this branch stopped at the `chmod` that used to precede it. The set was then taken from
# `ldd` over every shared object in `rdkit/` and `rdkit.libs/`, which reports nothing unresolved
# once these three are installed. No drawing happens; the libraries only have to resolve. They come
# from the base image's Debian archive rather than from `uv.lock`, which has no way to describe
# them, and they are installed first so the layer does not rebuild when the Python closure does.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libxrender1 libxext6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# **The models come out of the same wheelhouse as everything else**, which is the change
# `D-2026-09-26-the-labeller-s-torch-is-the-lock-s-torch` made. RXNMapper and Rxn-INSIGHT are the
# `models` extra, and the build stage above exports that extra from `uv.lock` and fetches it
# `--require-hashes` — so torch and the rest of their closure are the versions and the artefacts
# `make deps-audit` read, and nothing in this stage resolves anything (`--no-index`).
#
# They used to be a third `pip install` straight from PyPI through the CPU-torch
# `--extra-index-url`, pinned by version to the lock and to nothing else: their whole transitive
# closure — torch, transformers and tokenizers among it — re-resolved on every build, unhashed,
# and this was the one image whose closure the audit did not describe. The price of that fix was
# which torch shipped: the lock resolved PyPI's build, which carries the CUDA runtime wheels this
# CPU-only pod never loads — ~2.2 GB of the ~2.9 GB of wheels. The lock now resolves PyTorch's
# `+cpu` build on Linux for this image and `rxnpredict`'s, still by hash
# (`D-2026-09-27-a-cpu-pod-locks-the-cpu-torch`, which records the measured image sizes).
# `tests/test_fleet.py::test_no_image_installs_what_the_lock_did_not_hash` refuses the old form.
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels \
        mcp-server-kit "chemclaw-mcp-rxnlabel[models]" \
    && rm -rf /wheels

# **The offline switches, set before the check below so the check runs under them.** RXNMapper
# needs neither — it calls `from_pretrained` on a local directory — but they are what make a future
# `transformers` that consults the hub even for a local model fail here, at build time, instead of
# at a pod's first construction: there the armed egress guard would turn that call into an
# `EgressForbidden` (an `OSError`) which `mapping._mapper`'s `except Exception` records, and the
# pod would stay unready with the corpus unlabelled.
#
# No `HF_HOME` is set, deliberately. It used to name `/opt/models/hf` for a bake that was supposed
# to fill it, but the checkpoint was never there: with the weights in the package the bake wrote
# nothing, `/opt/models` never existed, and the `chmod -R a+rX /opt/models` after it failed the
# build (`D-2026-09-26-the-labeller-s-torch-is-the-lock-s-torch`). Naming a cache nothing fills only
# says there is one.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# **The load check.** It proves the claim above instead of trusting it: it constructs the mapper
# with the hub switched off, requires that the checkpoint it loaded is the one inside the installed
# `rxnmapper` package (not a cache nobody hashed), and maps one reaction, so a checkpoint that
# constructs but cannot run fails the build too. A build whose model does not load fails here,
# loudly, rather than shipping an image whose `/healthz` stays 503.
RUN python -c "import os, rxnmapper; from rxnmapper import RXNMapper; \
m = RXNMapper(); \
pkg = os.path.realpath(os.path.dirname(rxnmapper.__file__)); \
assert os.path.realpath(m.model_path).startswith(pkg + os.sep), m.model_path; \
r = m.get_attention_guided_atom_maps(['CC(=O)O.OCC>>CC(=O)OCC'])[0]; \
assert ':' in r['mapped_rxn'], r; \
print('rxnmapper loads its packaged checkpoint offline:', os.path.relpath(m.model_path, pkg))"

# Rxn-INSIGHT's SMIRKS ship inside its wheel, so there is nothing to fetch — but importing it once
# here fails the build on a broken install for the same reason.
RUN python -c "from rxn_insight.reaction import Reaction; print('rxn-insight importable')"

USER ${UID}
EXPOSE 8865

# The egress guard is armed on import and is left at its default. `MCP_EGRESS_ALLOW` is not set
# here, and setting it in a deployment is a decision to be argued for — the NetworkPolicy beside
# this file denies egress at the network layer regardless.
ENV MCP_EGRESS_GUARD=on

# **One thread per forward pass, pinned here rather than left to the node**
# (`D-2026-09-26-a-torch-image-pins-one-thread-per-forward-pass`). torch sizes its intra-op pool
# from the machine's cores, not from the container's CPU limit, so unpinned a forward pass in this
# two-core pod runs as many threads as the node has. Measured on 2026-09-26 in a `--cpus=2`
# container on an eight-core VM, torch 2.13.0 CPU: RXNMapper over 16 reactions took 4,014 ms
# unpinned (8 threads) against 395 ms at one thread and 224 ms at two, and a T5-small-shaped
# forward 3,993 / 1,359 / 860 ms — oversubscription, not parallelism. `inference_threads()` reads
# the pinned width, so the admission gate charges one slot per forward pass and a slot is a core
# by construction. Raise deliberately, on a pod sized for it; the gate follows without an edit.
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

# The build this image is. `mcp_server_kit.app.server_revision` reads `MCP_SERVER_REVISION` and
# carries it into the `initialize()` handshake's `serverInfo.version` and into `/healthz`, so a
# caller learns which build answered without a second endpoint. Left unsupplied it reports
# `"unknown"` — which is exactly what Chemclaw3's own revision field did for eight months, the
# field and its test both present and no build ever setting the variable. So `tests/test_fleet.py`
# asserts *this pair, in this file*: a provenance record nothing fills is one that quietly says
# nothing. The release pipeline passes `--build-arg CHEMCLAW_REVISION=$(git rev-parse HEAD)`.
ARG CHEMCLAW_REVISION=unknown
ENV MCP_SERVER_REVISION=${CHEMCLAW_REVISION}

# The startup probe Chemclaw3's connector health check uses is GET /healthz on this port.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8865/healthz').status==200 else 1)"

CMD ["uvicorn", "chemclaw_mcp_rxnlabel.app:app", "--host", "0.0.0.0", "--port", "8865"]
